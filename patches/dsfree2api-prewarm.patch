+// SessionExpiresAt reports when the site's cached verified cookies expire.
+// ok is false when there is no live session. Callers use it to refresh ahead
+// of the TTL (cookie_ttl_seconds) instead of waiting for the cache to lapse.
+func (s *Solver) SessionExpiresAt(siteCode, proxy string) (time.Time, bool) {
+	c := s.coreFor(proxy)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	st, ok := c.cache[siteCode]
+	if !ok || time.Now().After(st.expiresAt) {
+		return time.Time{}, false
+	}
+	return st.expiresAt, true
+}
